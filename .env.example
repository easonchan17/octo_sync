# Runtime environment: dev | prod | ml (ml only requires DB_URL; other required fields accept placeholders)
ENV=dev

# Code generation salts (required)
MATCH_CODE_SALT=change_me_match_salt
TEAM_CODE_SALT=change_me_team_salt
PLAYER_CODE_SALT=change_me_player_salt

# JWT signing secret for HS256 token issuance and verification (required for dev/prod; use placeholder for ml)
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret

# Cloudflare Turnstile secret key (optional; skip human verification if unset)
TURNSTILE_SECRET=

# Email sender identity (required when any email provider is configured)
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Takatikigo

# Email providers — configure at least one; router tries Brevo → Mailjet → Resend in order
BREVO_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
RESEND_API_KEY=

# HTTP server bind address (required for dev/prod; use placeholder for ml)
HTTP_HOST=change_me_host
HTTP_PORT=8000

# Allowed CORS origins for the browser frontend (comma-separated, or * for all). origin = scheme://host[:port], no trailing slash
CORS_ALLOW_ORIGINS=*
DOCS_USERNAME=
DOCS_PASSWORD=

# HTTP Basic auth for admin data endpoints (/api/data/*); set both to enable
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Redis connection (required)
REDIS_URL=redis://localhost:6379/0

# Database connection URL (required; used by the app and alembic)
DB_URL=postgresql://user:password@localhost:5432/dbname

# LLM provider API key — set the one matching the provider in configs/config.yml (llm.chat / llm.default).
# litellm reads it from the environment by provider:
#   anthropic -> ANTHROPIC_API_KEY | openai -> OPENAI_API_KEY | gemini -> GEMINI_API_KEY | deepseek -> DEEPSEEK_API_KEY
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
