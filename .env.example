# Runtime environment: dev | prod
ENV=dev

# Code generation salts (required)
MATCH_CODE_SALT=change_me_match_salt
TEAM_CODE_SALT=change_me_team_salt
PLAYER_CODE_SALT=change_me_player_salt

# Chat JWT verification: filesystem path to the main-site RS256 public key PEM
# Required to enable the chat WebSocket / conversation auth
JWT_PUBLIC_KEY_PATH=

# HTTP Basic auth for /docs and /redoc (optional; set both to enable docs)
HTTP_HOST=
HTTP_PORT=

# Allowed CORS origins for the browser frontend (comma-separated, or * for all). origin = scheme://host[:port], no trailing slash
CORS_ALLOW_ORIGINS=*
DOCS_USERNAME=
DOCS_PASSWORD=

# HTTP Basic auth for admin data endpoints (/api/data/*); set both to enable
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database connection (required; used by the app and alembic)
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# LLM provider API key — set the one matching the provider in configs/config.yml (llm.chat / llm.default).
# litellm reads it from the environment by provider:
#   anthropic -> ANTHROPIC_API_KEY | openai -> OPENAI_API_KEY | gemini -> GEMINI_API_KEY | deepseek -> DEEPSEEK_API_KEY
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
